# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///pulsewatch.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/pulsewatch

# Security
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key

# Session Configuration
SESSION_TIMEOUT=3600
PERMANENT_SESSION_LIFETIME=86400

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30

# Machine Learning Models
MODEL_VERSION=1.0
LSTM_MODEL_PATH=models/lstm_model.h5
XGBOOST_MODEL_PATH=models/xgboost_model.pkl

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pulsewatch.log

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=False
ENABLE_SMS_NOTIFICATIONS=False

# External APIs
WHO_API_KEY=your-who-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Data Source Configuration
DATA_SYNC_INTERVAL=3600
ENABLE_AUTOMATED_FORECASTS=True

# CORS Settings
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Monitoring
ENABLE_MONITORING=True
SENTRY_DSN=your-sentry-dsn
